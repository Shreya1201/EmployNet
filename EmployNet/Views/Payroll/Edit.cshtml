@model PayrollDto

<div class="row">
    <div class="col-md-8 mx-auto rounded border p-3">
        <h2 class="text-center mb-5">Edit Payroll</h2>

        <form method="post">
            <!-- Employee ID field (read-only) -->
            <div class="row mb-3">
                <label asp-for="EmployeeId" class="col-sm-4 col-form-label"></label>
                <div class="col-sm-8">
                    <input asp-for="EmployeeId" class="form-control-plaintext" readonly />
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
            </div>

            <!-- Base Salary field -->
            <div class="row mb-3">
                <label asp-for="BaseSalary" class="col-sm-4 col-form-label">Base Salary <span style="color: red;">*</span></label>
                <div class="col-sm-8">
                    <input asp-for="BaseSalary" class="form-control" />
                    <span asp-validation-for="BaseSalary" class="text-danger"></span>
                </div>
            </div>

            <!-- Bonus field -->
            <div class="row mb-3">
                <label asp-for="Bonus" class="col-sm-4 col-form-label">Bonus <span style="color: red;">*</span></label>
                <div class="col-sm-8">
                    <input asp-for="Bonus" class="form-control" />
                    <span asp-validation-for="Bonus" class="text-danger"></span>
                </div>
            </div>

            <!-- Deductions field -->
            <div class="row mb-3">
                <label asp-for="Deductions" class="col-sm-4 col-form-label">Deductions<span style="color: red;">*</span></label>
                <div class="col-sm-8">
                    <input asp-for="Deductions" class="form-control" />
                    <span asp-validation-for="Deductions" class="text-danger"></span>
                </div>
            </div>

            <!-- Pay Date field -->
            <div class="row mb-3">
                <label asp-for="PayDate" class="col-sm-4 col-form-label">Pay Date<span style="color: red;">*</span></label>
                <div class="col-sm-8">
                    <input asp-for="PayDate" class="form-control" type="date" />
                    <span asp-validation-for="PayDate" class="text-danger"></span>
                </div>
            </div>

            <!-- Save button -->
            <div class="row">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-primary" asp-action="Index" role="button">
                        Cancel
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
